{
  "$schema": "https://tabnas.dev/schema/plugin.schema.json",
  "name": "@tabnas/bnf",
  "go": "github.com/tabnas/bnf/go",
  "description": "Shared BNF-family grammar compiler for the tabnas engine, used by abnf, ebnf and gbnf.",
  "engine": "@tabnas/parser",
  "extensions": [
    ".bnf"
  ],
  "clib": {
    "dir": "go/clib",
    "library": "libtabnasbnf",
    "abi": "v1",
    "errorCodes": [
      "usage",
      "grammar",
      "handle",
      "internal"
    ]
  },
  "errorCodes": [],
  "docs": "https://tabnas.dev/docs/packages",
  "repository": "https://github.com/tabnas/bnf",
  "versionSource": "ts/package.json"
}
